@model Evento
@{
    ViewData["Title"] = "Nuevo evento";
}

<h1 class="h3">Nuevo evento</h1>
<hr />
<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Modalidad" class="form-label"></label>
                    <select asp-for="Modalidad" asp-items="ViewBag.Modalidades" class="form-select"></select>
                    <span asp-validation-for="Modalidad" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Lugar" class="form-label"></label>
                    <input asp-for="Lugar" class="form-control" />
                    <span asp-validation-for="Lugar" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Aforo" class="form-label"></label>
                    <input asp-for="Aforo" type="number" min="1" max="5000" class="form-control" />
                    <span asp-validation-for="Aforo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Precio" class="form-label"></label>
                    <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
