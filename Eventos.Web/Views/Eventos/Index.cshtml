@model IEnumerable<EventoResumen>
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="categoriaId" class="form-label">Filtrar por categoría</label>
        <select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">-- Todas las categorías --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle small">
        <thead class="table-light">
            <tr>
                <th>Título</th>
                <th>Categoría</th>
                <th>Fecha</th>
                <th>Lugar</th>
                <th>Modalidad</th>
                <th class="text-end">Precio (S/)</th>
                <th class="text-end">Aforo</th>
                <th class="text-end">Inscritos</th>
                <th class="text-end">Cupos disponibles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Titulo</td>
                    <td>@e.Categoria</td>
                    <td class="text-nowrap">
                        @e.Fecha.ToString("dd/MM/yyyy HH:mm")
                        @if (e.Fecha < DateTime.Now)
                        {
                            <div><span class="badge text-bg-secondary">Finalizado</span></div>
                        }
                    </td>
                    <td>@e.Lugar</td>
                    <td>
                        <span class="badge @(e.Modalidad == "Virtual" ? "text-bg-info" : "text-bg-light border")">@e.Modalidad</span>
                    </td>
                    <td class="text-end">@e.Precio.ToString("N2")</td>
                    <td class="text-end">@e.Aforo</td>
                    <td class="text-end">@e.Inscritos</td>
                    <td class="text-end">
                        @if (e.CuposDisponibles > 0)
                        {
                            <span class="badge text-bg-success">@e.CuposDisponibles</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Agotado</span>
                        }
                    </td>
                    <td class="text-nowrap text-end">
                        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">No hay eventos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
