@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var sinPanel = ViewData["SinPanel"] as bool? ?? false;
    string Activo(string nombre) => controlador == nombre ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Eventos.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-app" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="icono-marca" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="4.5" width="18" height="16.5" rx="2" fill="#8db4e8" />
                        <rect x="3" y="4.5" width="18" height="5" rx="2" fill="#5b8fd6" />
                        <rect x="3" y="7.5" width="18" height="2" fill="#5b8fd6" />
                        <rect x="7" y="2.5" width="2" height="4" rx="1" fill="#dbe7f7" />
                        <rect x="15" y="2.5" width="2" height="4" rx="1" fill="#dbe7f7" />
                        <g fill="#1c3150">
                            <rect x="6" y="12" width="2.6" height="2.2" rx=".4" />
                            <rect x="10.7" y="12" width="2.6" height="2.2" rx=".4" />
                            <rect x="15.4" y="12" width="2.6" height="2.2" rx=".4" />
                            <rect x="6" y="16" width="2.6" height="2.2" rx=".4" />
                            <rect x="10.7" y="16" width="2.6" height="2.2" rx=".4" />
                            <rect x="15.4" y="16" width="2.6" height="2.2" rx=".4" />
                        </g>
                    </svg>
                    Eventos e Inscripciones
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Eventos")" asp-area="" asp-controller="Eventos" asp-action="Index">Eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Asistentes")" asp-area="" asp-controller="Asistentes" asp-action="Index">Asistentes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Inscripciones")" asp-area="" asp-controller="Inscripciones" asp-action="Index">Inscripciones</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (sinPanel)
            {
                @RenderBody()
            }
            else
            {
                <div class="panel">
                    @RenderBody()
                </div>
            }
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Today.Year - Eventos e Inscripciones - EF Core Code First
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
