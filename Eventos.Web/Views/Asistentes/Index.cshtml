@model IEnumerable<Asistente>
@{
    ViewData["Title"] = "Asistentes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Asistentes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo asistente</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nombres)</th>
                <th>@Html.DisplayNameFor(m => m.Dni)</th>
                <th>@Html.DisplayNameFor(m => m.Correo)</th>
                <th>@Html.DisplayNameFor(m => m.Telefono)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Nombres</td>
                    <td>@a.Dni</td>
                    <td>@a.Correo</td>
                    <td>@(a.Telefono ?? "—")</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No hay asistentes registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
